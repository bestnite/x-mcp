{
  "name": "@nite/x-mcp",
  "version": "0.1.1",
  "type": "module",
  "description": "Read-only MCP server for X (Twitter) via its internal GraphQL API",
  "license": "MIT",
  "bin": {
    "x-mcp": "dist/stdio.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "twitter",
    "x",
    "model-context-protocol",
    "graphql"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://git.nite07.com/nite/x-mcp.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "start:stdio": "node dist/stdio.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  }
}
