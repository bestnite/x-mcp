# X session cookies. This file is a full login state — never commit it.
# Extract from a logged-in browser: devtools -> Application -> Cookies -> x.com
auth_token=
ct0=
twid=
lang=zh-cn

# Server bind address (127.0.0.1 keeps it off the LAN; put it behind a gateway otherwise)
X_MCP_HOST=127.0.0.1
X_MCP_PORT=8787

# How long to cache the queryId table from main.js
X_OPERATIONS_TTL_MS=21600000
