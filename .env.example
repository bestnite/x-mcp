# X session cookies. This is a complete login state — treat it as a password,
# keep the file at mode 600, and never commit it.
# Extract from a signed-in browser: DevTools -> Application -> Cookies -> x.com
auth_token=
ct0=
# Optional: affects the language of X responses
lang=zh-cn
# Optional: accepted but not required
# twid=u%3D

# HTTP entrypoint settings (only used by `npm start`)
X_MCP_HOST=127.0.0.1
X_MCP_PORT=8787

# How long to cache the queryId table extracted from X's frontend
X_OPERATIONS_TTL_MS=21600000
